# Rotaract Club of Navi Mumbai - Environment Configuration

# Email Notification Recipients (Comma-separated recipient emails)
NOTIFICATION_EMAIL="yashsarawgi20@gmail.com, info@rotaractclubofnavimumbai.org"

# Nodemailer SMTP Service Configuration (e.g. Gmail / SendGrid / cPanel Webmail / Mailgun)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-organization-email@gmail.com"
SMTP_PASS="your-app-password"

# Optional Supabase Database Credentials (If connecting live Supabase instance)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
